# Optional gateway for an HTTPS upstream on a private network.
# Render with pnpm gateway:render /path/outside/repository/relay.caddy.
{$RELAY_DOMAIN} {
    reverse_proxy {$RELAY_UPSTREAM} {
        header_up Host {$RELAY_UPSTREAM_HOST}
        header_up X-Forwarded-For {remote_host}
        transport http {
            tls_server_name {$RELAY_UPSTREAM_HOST}
        }
    }
}
