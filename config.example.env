# Optional. Copy to ~/.config/relay/local.env and chmod 600 that file.
# Environment variables override this file. RELAY_CONFIG_FILE selects another file.
RELAY_DEFAULT_SERVER=http://127.0.0.1:4318
RELAY_APPLE_TEAM=
RELAY_BUNDLE_ID_PREFIX=org.example.relay
# Only needed for deployments behind a separately managed HTTPS gateway.
RELAY_DOMAIN=relay.example.com
RELAY_TRUSTED_PROXIES=loopback
RELAY_UPSTREAM=https://service.example.ts.net
RELAY_UPSTREAM_HOST=service.example.ts.net
